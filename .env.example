# ---------------------------------------------------------------------------
# required
# ---------------------------------------------------------------------------
# Bot token from "OAuth & Permissions" (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token with connections:write, from "Basic Information" (xapp-...)
SLACK_APP_TOKEN=xapp-your-app-token
# Your own Slack user id (Profile -> ... -> Copy member ID), e.g. U012ABCDEF
OWNER_USER_ID=U012ABCDEF

# ---------------------------------------------------------------------------
# basics
# ---------------------------------------------------------------------------
BOT_NAME="Chicen Nugget Bot"
# Any IANA timezone. Used for reminders and the daily digest.
TIMEZONE=UTC
# Comma separated. Defaults to OWNER_USER_ID.
ADMIN_USER_IDS=
# Optional: a user token (xoxp-... or browser xoxc-...) enables the Boi personal
# assistant account: DMs, Slack search, usergroups, typing indicators.
SLACK_USER_TOKEN=
# If using browser session (xoxc-...), provide the 'd' cookie (xoxd-...):
SLACK_USER_COOKIE=
# Note: the bot app and Boi share one codebase/database but are separate Slack
# tokens. They cannot act as each other.
#
# Posting "in my name" (as_user=true) works without any of these: the bot app
# posts with the owner's display name and profile picture via Slack's
# chat:write.customize scope, with a small "Sent by @assistant" line. The app
# badge stays visible. Make sure the bot has `chat:write.customize` and
# `users:read`, then reinstall it to the workspace.
#
# Optional: the OWNER'S OWN user token upgrades as_user=true to a fully native
# post from their real profile (no app badge). It must belong to OWNER_USER_ID.
# Get it from the owner's own Slack session (xoxp-...), or xoxc-... + cookie.
SLACK_OWNER_TOKEN=
SLACK_OWNER_COOKIE=

# ---------------------------------------------------------------------------
# welcomer (personal / watched channels, not the whole workspace)
# ---------------------------------------------------------------------------
# Comma separated channel ids to watch for joins/leaves. Use * for every channel
# the bot is in. Leave empty to disable the welcomer. Change at runtime with
# `/nugget config watched_channels #channel` or ask the bot.
WATCHED_CHANNEL_IDS=
WELCOME_PUBLIC=true
WELCOME_MESSAGE=welcome to {channel}, {user}! :wave: glad you're here.
# Sent once per member as a DM. {user}, {channel}, {bot} are replaced.
WELCOME_DM=hey {user}! welcome to {channel} :blob-wave: i'm {bot}. if you ever need anything in here, just ping me.
WELCOME_DM_ONCE=true
# Optional raw Slack usergroup mention appended to the public welcome, e.g.
# <!subteam^S0123456789>. This pings the group when someone joins.
WELCOME_PING=
# Where join/leave/access events are logged. Empty disables the log.
LOGS_CHANNEL_ID=
# Optional ping group (usergroup id, S...). Needs SLACK_USER_TOKEN with
# usergroups:read + usergroups:write.
USERGROUP_ID=
# true = DM new members and let them opt in with buttons; false = add them
# automatically on join.
USERGROUP_PROMPT=true
# Shown in the opt-in DM. {user}, {channel}, {bot} are replaced.
USERGROUP_PROMPT_TEXT=want me to add you to the *ping group*? you'll get pinged when something good happens — no spam, promise.
# Only ask each person once, even if they join several watched channels.
USERGROUP_PROMPT_ONCE=true

# ---------------------------------------------------------------------------
# tier 2 access requests
# ---------------------------------------------------------------------------
# The private channel people are asking to join. Leave empty to disable.
ACCESS_CHANNEL_ID=
# Channel where the "request access" panel is posted/updated. Defaults to the
# first watched channel if empty.
ACCESS_PANEL_CHANNEL_ID=
ACCESS_PANEL_TEXT="*tier 2 access* :lock:\nwant into the private tier 2 channel? hit the button, tell me why, and i'll send it to the admins."
# Minimum hours between requests from the same person.
ACCESS_COOLDOWN_HOURS=24
# Shared channel for approval buttons. Empty = DM every admin.
ADMIN_CHANNEL_ID=
# Instantly invite people instead of waiting for an admin review.
ACCESS_AUTO_APPROVE=false

# ---------------------------------------------------------------------------
# usergroup helpers
# ---------------------------------------------------------------------------
# DM people who reply in a thread under a usergroup ping.
USERGROUP_GUARD=true
# When a usergroup ping includes 🧵, post a "thread here!" anchor; otherwise
# offer yes/no buttons. Replying in threads on pings re-pings the whole group.
THREAD_HELPER=true

# ---------------------------------------------------------------------------
# daily recap
# ---------------------------------------------------------------------------
# Public channel for the daily "how was your day?" prompt. Empty disables recaps.
RECAP_CHANNEL_ID=
# Optional private channel for the follow-up private recap.
RECAP_PRIVATE_CHANNEL_ID=
# "HH:MM" in TIMEZONE for the public recap prompt. Requires RECAP_CHANNEL_ID.
RECAP_TIME=
# DM a heads-up this many minutes before the recap. 0 disables it.
RECAP_REMINDER_MINUTES=10
# Optional usergroup id (S...) to ping when a recap is marked done.
RECAP_PING=
# Optional usergroup id (S...) to ping when the private recap is done.
RECAP_PRIVATE_PING=

# ---------------------------------------------------------------------------
# ai agent (Hack Club AI: https://docs.ai.hackclub.com)
# ---------------------------------------------------------------------------
# Hack Club AI is OpenAI-compatible. Any OpenAI-compatible endpoint also works.
AI_API_KEY=
AI_BASE_URL=https://ai.hackclub.com/proxy/v1
# Bot app: cheap + fast, handles public channels, ambient chatter and slash commands.
AI_MODEL=deepseek/deepseek-v4.1-flash
# Tried automatically when the primary model errors or times out.
AI_FALLBACK_MODEL=anthropic/claude-haiku-5.5
# Boi (personal assistant account): can run a stronger model than the bot app.
# Recommendation: anthropic/claude-sonnet-5 for agentic quality, or
# anthropic/claude-haiku-5.5 / openai/gpt-6-luna for a cheaper balance.
# Set AI_ASSISTANT_MODEL=$AI_MODEL to use one model everywhere.
AI_ASSISTANT_MODEL=anthropic/claude-sonnet-5
AI_ASSISTANT_FALLBACK_MODEL=anthropic/claude-haiku-5.5
# Optional stronger model for tool-heavy turns (sandbox, GitHub writes, browser,
# API calls). Empty means use the normal model for that identity.
AI_CODE_MODEL=
AI_CODE_FALLBACK_MODEL=
AI_MAX_TOKENS=1200
AI_HISTORY_LIMIT=24
# Trim older turns so a long thread can't balloon the input bill.
AI_MAX_CONTEXT_CHARS=24000
# Channels where the bot will answer mentions and /ask, /summarize. * = all.
AI_CHANNELS=*
# Let admins talk to the agent in DMs too (owner always can).
AI_ALLOW_ADMINS=true
# Sliding-window cap per user across agent turns, /ask, /summarize, /imagine. 0 disables.
AI_RATE_LIMIT_PER_MINUTE=12
# Workspace-wide cap so a crowd can't start 50 turns at once. 0 disables.
AI_GLOBAL_RATE_LIMIT_PER_MINUTE=30
# Per-user spend for the UTC day. Once one person reaches it, their AI requests
# stop until 00:00 UTC. The owner is never capped. 0 disables the cap.
AI_USER_DAILY_BUDGET_USD=0.50
# Optional bot-wide stop. Off by default because Hack Club AI already enforces
# the account's daily allowance. Set a number if you want a second ceiling.
AI_DAILY_BUDGET_USD=0
# Jev is a decision model: it reads a message and returns typed probabilities
# (should the bot reply, was it addressed to the bot, is it spam, what kind of
# message is it). Only a confident YES runs the expensive agent turn.
AI_GATE_ENABLED=true
AI_GATE_MODEL=jev-latest
AI_GATE_TIMEOUT=8
# Defaults to <AI_BASE_URL>/jev/systemone. Override only for a different Jev host.
AI_JEV_URL=
# How confident Jev must be that a reply adds something. Higher = quieter.
AI_GATE_MIN_CONFIDENCE=0.5
# If Jev is this sure the message is aimed at the bot, reply even if it is chatty.
AI_GATE_ADDRESSED_CONFIDENCE=0.6
# At or above this spam probability, never reply.
AI_GATE_SPAM_THRESHOLD=0.7
# Channels where the bot listens to every message and lets jev decide. Empty = off.
AI_AMBIENT_CHANNELS=
# Minimum seconds between unprompted replies in one channel. 0 disables.
AI_AMBIENT_COOLDOWN=120
# Minimum seconds between unprompted replies in one thread. 0 disables.
AI_THREAD_COOLDOWN=120
# Persistent sandbox workspaces for owner/admin repo work and shell commands.
# Defaults to <DATA_DIR>/sandboxes. This is a workspace boundary, not a jail.
SANDBOX_DIR=
# Maximum number of sandboxes kept at once. Delete old ones to free space.
SANDBOX_MAX_WORKSPACES=20
# Default and hard-cap seconds for a sandbox command.
SANDBOX_EXEC_TIMEOUT=120
SANDBOX_MAX_EXEC_TIMEOUT=600
# Headless Chromium for the browser tool (owner/admin DMs only).
# Install once with scripts/install_browser.sh after pip install.
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30
BROWSER_MAX_SESSIONS=2
BROWSER_IDLE_TIMEOUT=900
# Defaults to <DATA_DIR>/browser.
BROWSER_DIR=
# Image generation (used by /imagine). Empty disables the command.
# Strong option: google/gemini-3.1-flash-image (Nano Banana 2).
IMAGINE_MODEL=google/gemini-3.1-flash-image
IMAGINE_FALLBACK_MODEL=google/gemini-3.1-flash-lite-image
# Non-admin users allowed to generate images. Comma-separated Slack user ids.
# Admins always have access; add/remove more at runtime with
# `/nugget imageaccess add @user` or by asking the bot.
IMAGE_ALLOWED_USER_IDS=
# Rough charge per generated image, recorded against the caller's daily spend.
AI_IMAGE_COST_USD=0.04

# ---------------------------------------------------------------------------
# extras
# ---------------------------------------------------------------------------
# "HH:MM" in TIMEZONE. Empty disables the daily admin digest.
DAILY_DIGEST_TIME=
# Optional default place for the weather tool, e.g. Amsterdam
WEATHER_DEFAULT_LOCATION=
# Optional Tavily key enables the search_web tool.
TAVILY_API_KEY=
# Safety cap for active reminders.
MAX_REMINDERS=200

# ---------------------------------------------------------------------------
# personal integrations (optional)
# ---------------------------------------------------------------------------
# You can set all of these from Slack with `/nugget setup` instead of editing
# this file. SQLite values win over environment values, so a chat setup survives
# restarts even if the env var is empty. Secrets are stored in data/bot.db.
#
# Google Workspace (Calendar, Gmail, Drive). Create a Desktop OAuth client and
# add http://localhost:9876/oauth2callback as a redirect URI, then run
# `/nugget setup google`. The refresh token from that flow is enough; these env
# values are only a fallback/bootstrap.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:9876/oauth2callback
#
# GitHub API. A token is optional for public reads, required for notifications.
GITHUB_USERNAME=
GITHUB_TOKEN=
REPO_URL=
#
# IMAP email (Gmail/Fastmail app passwords work). Prefer `/nugget setup email`.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
#
# Mac companion bridge (scripts/mac_companion.py). Prefer `/nugget setup mac`.
MAC_BRIDGE_URL=
MAC_BRIDGE_TOKEN=
#
# Optional API tokens for the generic `api_request` tool. Prefer
# `/nugget setup apis`; these env values are fallbacks.
VERCEL_TOKEN=
CLOUDFLARE_API_TOKEN=
NOTION_TOKEN=
LINEAR_API_KEY=
SENTRY_AUTH_TOKEN=
RESEND_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
